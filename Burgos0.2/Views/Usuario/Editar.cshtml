@model Burgos0._2.Models.UsuarioEditViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/create.css"
          asp-append-version="true" />
}

<div class="content">

   
    <div class="page-header">
        <h2>Editar Usuario</h2>
    </div>

    <form asp-controller="Usuario"
          asp-action="Editar"
          method="post"
          id="editForm">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <input asp-for="UsuarioId"
               type="hidden" />

        <div class="form-group">

            <label asp-for="NombreUsuario"></label>

            <input asp-for="NombreUsuario"
                   class="form-control"
                   placeholder="Ingrese nombre de usuario" />

            <span asp-validation-for="NombreUsuario"
                  class="text-danger"></span>

        </div>

        <div class="form-group">

            <label asp-for="Email"></label>

            <input asp-for="Email"
                   class="form-control"
                   placeholder="ejemplo@correo.com" />

            <span asp-validation-for="Email"
                  class="text-danger"></span>

        </div>

        <div class="form-group">

            <label asp-for="Estado"></label>

            <input asp-for="Estado" />

        </div>

        <button type="submit"
                class="btn btn-success">
            Actualizar
        </button>

        <a asp-controller="Usuario"
           asp-action="Index"
           class="btn btn-secondary">
            Cancelar
        </a>

    </form>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message-banner">
            @TempData["SuccessMessage"]
        </div>
    }


</div>

@section Scripts {

    <script>
        document.getElementById("editForm").addEventListener("submit", function (e) {
            if (!confirm("¿Desea actualizar este usuario?")) {
                e.preventDefault();
            }
        });
    </script>
   

}
