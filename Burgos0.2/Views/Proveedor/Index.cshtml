@model IEnumerable<Burgos0._2.Models.ProveedorViewModel>

@{
    ViewData["Title"] = "Proveedores";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/index.css"
          asp-append-version="true" />
}

<div class="page-header">

    <h1>Proveedores</h1>

    <a asp-controller="Proveedor"
       asp-action="Crear"
       class="btn-primary">
        ＋ Nuevo Proveedor
    </a>

</div>

<div class="table-container">

    <table class="custom-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Email</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.ProveedorId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Email</td>
                    <td>@item.Telefono</td>
                    <td>@item.Direccion</td>

                    <td>

                        <div class="table-actions">

                            <a asp-controller="Proveedor"
                               asp-action="Detalle"
                               asp-route-id="@item.ProveedorId"
                               class="btn-table-edit">
                                🔍 Detalle
                            </a>

                            <a asp-controller="Proveedor"
                               asp-action="Editar"
                               asp-route-id="@item.ProveedorId"
                               class="btn-table-edit">
                                ✏️ Editar
                            </a>

                            <a asp-controller="Proveedor"
                               asp-action="Eliminar"
                               asp-route-id="@item.ProveedorId"
                               class="btn-table-delete">
                                🗑️ Eliminar
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>