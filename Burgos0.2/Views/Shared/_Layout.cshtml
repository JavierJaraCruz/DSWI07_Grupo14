@{
    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema Inventario</title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/sidebar.css"
          asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    @RenderSection("Styles", required: false)

</head>

<body>

    <aside class="sidebar">

        <div class="sidebar-brand">
            <h2>Sistema Inventario</h2>
            <span>ecommerce Burgos</span>
        </div>

        <ul class="sidebar-menu">

            <li class="@(controllerActual == "Home" ? "active" : "")">
                <a href="@Url.Action("Index", "Home")">
                    🏠
                    <span>Inicio</span>
                </a>
            </li>

            <li class="@(controllerActual == "Orden" ? "active" : "")">
                <a href="@Url.Action("Index", "Orden")">
                    🛒
                    <span>Ventas</span>
                </a>
            </li>

            <li class="@(controllerActual == "Producto" ? "active" : "")">
                <a href="@Url.Action("Index", "Producto")">
                    📦
                    <span>Productos</span>
                </a>
            </li>

            <li class="@(controllerActual == "Categoria" ? "active" : "")">
                <a href="@Url.Action("Index", "Categoria")">
                    🏷
                    <span>Categorías</span>
                </a>
            </li>

            <li class="@(controllerActual == "Proveedor" ? "active" : "")">
                <a href="@Url.Action("Index", "Proveedor")">
                    🚚
                    <span>Proveedores</span>
                </a>
            </li>

            <li class="@(controllerActual == "Usuario" ? "active" : "")">
                <a href="@Url.Action("Index", "Usuario")">
                    👥
                    <span>Usuarios</span>
                </a>
            </li>
            
            <li>
                <a href="@Url.Action("Logout", "Login")">
                    🚪
                    <span>Cerrar sesión</span>
                </a>
            </li>

        </ul>

        

    </aside>

    <main class="content">

        @RenderBody()

    </main>

    @RenderSection("Scripts", required: false)

</body>

</html>