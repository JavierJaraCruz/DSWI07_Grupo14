@model Burgos0._2.Models.ProductoViewModel

@{
    ViewData["Title"] = "Detalle del Producto";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/detalle.css"
          asp-append-version="true" />
}

<div class="card">

    <h2>Detalle del Producto</h2>

    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
    {
        <img src="@Model.ImagenUrl"
             alt="@Model.Nombre"
             style="max-width:300px; margin-bottom:25px;" />
    }

    <dl class="dl-horizontal">

        <dt>ID</dt>
        <dd>@Model.ProductoId</dd>

        <dt>Nombre</dt>
        <dd>@Model.Nombre</dd>

        <dt>Descripción</dt>
        <dd>@Model.Descripcion</dd>

        <dt>Precio</dt>
        <dd>S/. @Model.Precio</dd>

        <dt>Stock</dt>
        <dd>@Model.Stock</dd>

        <dt>Categoría</dt>
        <dd>@Model.CategoriaNombre</dd>

    </dl>

    <p>

        <a asp-controller="Producto"
           asp-action="Editar"
           asp-route-id="@Model.ProductoId"
           class="btn btn-warning">
            Editar
        </a>

        <a asp-controller="Producto"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>

    </p>

</div>