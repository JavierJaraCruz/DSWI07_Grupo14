@model Burgos0._2.Models.ProductoViewModel

@{
    ViewBag.Title = "Detalle del Producto";
}

<h2>Detalle del Producto</h2>

<div class="card" style="max-width:600px">

    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
    {
        <img src="@Model.ImagenUrl"
             alt="@Model.Nombre"
             style="max-width:300px; margin-bottom:15px;" />
    }

<dl class="dl-horizontal">
    <dt>ID</dt>
    <dd>@Model.ProductoId</dd>

    <dt>Nombre</dt>
    <dd>@Model.Nombre</dd>

    <dt>Descripción</dt>
    <dd>@Model.Descripcion</dd>

    <dt>Precio</dt>
    <dd>S/. @Model.Precio</dd>

    <dt>Stock</dt>
    <dd>@Model.Stock</dd>

    <dt>Categoría</dt>
    <dd>@Model.CategoriaNombre</dd>
</dl>

    <p>
        @Html.ActionLink("Editar", "Editar",
            new { id = Model.ProductoId },
            new { @class = "btn btn-primary" })

        @Html.ActionLink("Volver", "Index",
            null,
            new { @class = "btn btn-secondary" })
    </p>

</div>