@model Burgos0._2.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Iniciar Sesión</title>

    <link rel="stylesheet"
          href="~/css/login.css" />
</head>

<body class="login-body">

    <div class="login-container">

        <div class="login-card">

            <h2>Sistema Inventario</h2>

            <span>ecommerce Burgos</span>

            <form asp-action="Login"
                  asp-controller="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>

                <div class="form-group">

                    <label asp-for="NombreUsuario"></label>

                    <input asp-for="NombreUsuario"
                           class="form-input"
                           placeholder="Ej. admin"
                           autocomplete="off" />

                    <span asp-validation-for="NombreUsuario"
                          class="text-danger">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Password"></label>

                    <input asp-for="Password"
                           class="form-input"
                           placeholder="••••••••" />

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn-login">
                    Iniciar Sesión
                </button>

            </form>

        </div>

    </div>

</body>

</html>