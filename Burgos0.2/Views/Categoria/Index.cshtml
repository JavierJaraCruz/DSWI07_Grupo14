@model IEnumerable<Burgos0._2.Models.CategoriaViewModel>

@{
    ViewData["Title"] = "Categorías";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/index.css"
          asp-append-version="true" />
}

<div class="page-header">

    <h1>Categorías</h1>

    <a asp-controller="Categoria"
       asp-action="Crear"
       class="btn-primary">
        ＋ Nueva Categoría
    </a>

</div>

<div class="table-container">

    <table class="custom-table">

        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Acciones</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        @item.CategoriaId
                    </td>

                    <td>
                        @item.Nombre
                    </td>

                    <td>
                        @item.Descripcion
                    </td>

                    <td>

                        <div class="table-actions">

                            <a asp-controller="Categoria"
                               asp-action="Detalle"
                               asp-route-id="@item.CategoriaId"
                               class="btn-table-edit">
                                🔍 Detalle
                            </a>

                            <a asp-controller="Categoria"
                               asp-action="Editar"
                               asp-route-id="@item.CategoriaId"
                               class="btn-table-edit">
                                ✏️ Editar
                            </a>

                            <a asp-controller="Categoria"
                               asp-action="Eliminar"
                               asp-route-id="@item.CategoriaId"
                               class="btn-table-delete">
                                🗑️ Eliminar
                            </a>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>