@model Burgos0._2.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Crear Categoría";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/create.css"
          asp-append-version="true" />
}

<div class="page-header">
    <h2>Crear Categoría</h2>
</div>

<form asp-controller="Categoria"
      asp-action="Crear"
      method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="validation-summary-errors">
    </div>

    <div class="form-group">
        <label asp-for="Nombre"></label>

        <input asp-for="Nombre"
               class="form-control"
               placeholder="Ingrese el nombre de la categoría" />

        <span asp-validation-for="Nombre"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Descripcion"></label>

        <textarea asp-for="Descripcion"
                  class="form-control"
                  rows="4"
                  placeholder="Ingrese una descripción"></textarea>

        <span asp-validation-for="Descripcion"
              class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-success">
            Guardar
        </button>

        <a asp-controller="Categoria"
           asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>
    </div>
    

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
